<?xml version="1.0" encoding="utf-8"?>
<!-- Keyboard-shortcut screen, driven by InputKeyShortcutSetupActivity. One key_shortcut_row.xml is
     inflated per InputKeyShortcut.Action into the key_shortcut_rows container below, so the
     per-action controls and their wiring stay in one place rather than being repeated here. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/key_shortcut_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/special_key_reference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="10dp"
            android:text="@string/main_activity_special_key_reference" />
    </LinearLayout>
</ScrollView>
